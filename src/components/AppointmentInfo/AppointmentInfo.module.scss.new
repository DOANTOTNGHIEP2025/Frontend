.wrapper{
    width: 350px;
    overflow: visible;
    background-color: ${colors.primary};
    margin-top: 20px;
    text-decoration: none;
    border-radius: 12px;
    box-shadow: 0 5px 15px rgba(12, 80, 124, 0.15);
    transition: all 0.3s ease;

    &:hover {
        transform: translateY(-5px);
        box-shadow: 0 8px 20px rgba(12, 80, 124, 0.25);
    }
}

.appointment-title-wrapper{
    width: 100%;
    background: linear-gradient(135deg, ${colors.primary}, ${colors.primaryDark});
    height: 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    position: relative;
    overflow: hidden;

    &::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(to right, rgba(255, 255, 255, 0.1), transparent);
        pointer-events: none;
    }
}

.appointment-info-wrapper{
    width: 100%;
    background: linear-gradient(to bottom, ${colors.secondary}, ${colors.primary});
    height: 360px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border-bottom-left-radius: 12px;
    border-bottom-right-radius: 12px;
}

.appointment-field-wrapper{
    width: 100%;
    height: 50px;
    display: flex;
    align-items: center;
    padding: 0 10px;
    transition: background-color 0.2s ease;

    &:hover {
        background-color: rgba(255, 255, 255, 0.1);
    }
}

.title{
    margin-left: 10px;
    font-size: 1.4rem;
    font-weight: 600;
    color: #fff;
    text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
    letter-spacing: 0.5px;
}

.image-wrapper{
    width: 160px;
    height: 160px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: center;
    background-color: #fff;
    margin: 10px;
    border-radius: 20px;
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    transition: transform 0.3s ease;

    &:hover {
        transform: scale(1.03);
    }
}

.speciality-image{
    width: 100px;
    height: 100px;
    object-fit: contain;
    transition: transform 0.3s ease;

    &:hover {
        transform: scale(1.1);
    }
}

.speciality-name{
    font-size: 1.8rem;
    color: ${colors.primary};
    font-weight: 500;
    line-height: 2rem;
    width: 140px;
    height: 4rem;
    margin-top: 2px;
    overflow: hidden;
    display: block;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    margin-bottom: 20px;
    text-align: center;
}

.appointment-field-title{
    font-size: 1.4rem;
    font-weight: 500;
    color: #fff;
    margin-left: 10px;
    display: flex;
    align-items: center;

    svg {
        margin-right: 8px;
    }
}

.appointment-field{
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    margin-left: 10px;
    text-shadow: 1px 1px 1px rgba(0, 0, 0, 0.1);
}

.cancel-button{
    width: 60px;
    height: 40px;
    border: none;
    background-color: transparent;
    text-align: center;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.2s ease;

    &:hover{
        background-color: rgba(255, 255, 255, 0.2);
    }
}

.cancel-button-icon{
    font-size: 1.4rem;
    font-weight: 500;
    color: #fff;
}

.buttons-container {
    display: flex;
    height: 40px;
    overflow: visible;
}
